#!/usr/bin/env python3
"""stomp – control the JME STOMPBOX from the Pi's command line.

Talks to the stompboxd service, so it uses the same pedal connection and
state as the footswitches and the settings page.

  stomp mod off            effects: mod delay reverb gate eq
  stomp reverb toggle      on | off | toggle
  stomp all off            all effects on | off
  stomp preset 12          go to preset 12   (or: next | prev)
  stomp cc 6 64            raw Control Change: CC number, value (0-127)
  stomp status             connection, pedal, effects
"""
import json, sys, urllib.request

API = "http://127.0.0.1"
EFFECTS = ("mod", "delay", "reverb", "gate", "eq")


def call(path, body=None):
    req = urllib.request.Request(API + path, data=None if body is None else json.dumps(body).encode(),
                                 method="GET" if body is None else "POST")
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        return json.load(e)
    except OSError as e:
        sys.exit(f"stompboxd is not reachable ({e}). Check: systemctl status stompbox-ctrl")


def action(a):
    r = call("/api/action", a)
    if not r.get("ok"):
        sys.exit(r.get("error", "failed"))
    print("sent", a)


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip()); return
    cmd = argv[0]
    if cmd == "status":
        s = call("/api/status")
        p = s.get("pedal", {})
        print(f"stompboxd {s.get('version', '?')}")
        print(f"pedal: {p.get('name')} {p.get('mac') or '(not paired yet)'} – {p.get('state')}")
        print(f"MIDI port: {s.get('midi_port') or 'none'}   preset: {s.get('program')}")
        print("effects: " + "  ".join(f"{k.upper()}={'on' if v else 'off'}" for k, v in s["effects"].items()))
        print(f"profile: {s.get('profile')} buttons   GPIO: {s.get('gpio')}")
    elif cmd in EFFECTS and len(argv) == 2 and argv[1] in ("on", "off", "toggle"):
        action({"type": argv[1], "effect": cmd})
    elif cmd == "all" and len(argv) == 2 and argv[1] in ("on", "off"):
        action({"type": "all_" + argv[1]})
    elif cmd == "preset" and len(argv) == 2:
        if argv[1] in ("next", "prev"):
            action({"type": "preset_" + argv[1]})
        else:
            action({"type": "preset", "preset": int(argv[1])})
    elif cmd == "cc" and len(argv) == 3:
        r = call("/api/cc", {"cc": int(argv[1]), "value": int(argv[2])})
        if not r.get("ok"):
            sys.exit(r.get("error", "failed"))
        print(f"sent CC {argv[1]} = {argv[2]}" + ("" if r.get("connected") else "  (pedal not connected!)"))
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
